# Values for the Portainer stack (Environment variables) or a .env file next to docker-compose.yml.

# Your public address. With the default Caddyfile this must be a real domain pointing at your IP.
STUDIO_DOMAIN=studio.example.com
STUDIO_PUBLIC_URL=https://studio.example.com

# Developer account created on the very first start (database empty). Pick a long password, then you can remove these.
STUDIO_OWNER_EMAIL=you@example.com
STUDIO_OWNER_NAME=Your Name
STUDIO_OWNER_PASSWORD=change-me-to-a-long-password

# Only let these addresses in (the client's fixed IP and your own). Leave as is to allow everyone (login still required).
# STUDIO_ALLOW_IPS=41.1.2.3 196.2.3.4

# No domain or no Let's Encrypt? Use the self-made certificate instead.
# CADDYFILE=Caddyfile.internal

# Folder on the VM that holds the repo's planning files (flows, questions, decisions, handoffs).
# PLANNING_HOST_DIR=/opt/tapit/planning

# Optional email notifications through your own SMTP server.
# STUDIO_SMTP_HOST=
# STUDIO_SMTP_PORT=587
# STUDIO_SMTP_USER=
# STUDIO_SMTP_PASS=
# STUDIO_MAIL_FROM=studio@example.com
