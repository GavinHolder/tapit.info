# Copy to .env.local (WebStorm / local) or set in the Portainer stack. Never commit real values.

# First start only: creates the developer (owner) account when the database is empty.
STUDIO_OWNER_EMAIL=you@example.com
STUDIO_OWNER_NAME=Your Name
STUDIO_OWNER_PASSWORD=a-long-password-10-plus-characters

# Optional email notifications through YOUR own SMTP server. Leave STUDIO_SMTP_HOST empty to turn email off.
STUDIO_SMTP_HOST=
STUDIO_SMTP_PORT=587
STUDIO_SMTP_SECURE=0
STUDIO_SMTP_USER=
STUDIO_SMTP_PASS=
STUDIO_MAIL_FROM=studio@example.com
# Link used inside emails (the address the client opens)
STUDIO_PUBLIC_URL=http://localhost:3100

# Optional WhatsApp through your own OpenWA gateway (see docs/04-whatsapp-openwa.md). Leave empty to turn it off.
# Use a dedicated number: OpenWA is unofficial and a number can be restricted.
STUDIO_WA_URL=
STUDIO_WA_API_KEY=
STUDIO_WA_SESSION=
# 16+ characters. Needed only if replies from WhatsApp should come back into Studio.
STUDIO_WA_WEBHOOK_SECRET=
STUDIO_WA_DEFAULT_COUNTRY=27
# Most WhatsApp digests one person can get per day (protects the number)
STUDIO_WA_MAX_PER_DAY=30
# Wait this long before notifying (email and WhatsApp), so several replies become one message
STUDIO_NOTIFY_DELAY_SECONDS=120
